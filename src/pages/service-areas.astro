---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, PHONE, PHONE_TEL, ADDRESS } from '../consts';
---

<!doctype html>
<html lang="en">
<head>
	<BaseHead title={`Service Areas | ${SITE_TITLE}`} description="Drain cleaning and sewer services serving Santa Clarita, Valencia, Canyon Country, Newhall, Stevenson Ranch, and the greater Santa Clarita Valley in California." />
</head>
<body>
	<Header />

	<section class="page-hero">
		<div class="container">
			<h1>Service Areas</h1>
			<p>Proudly serving Santa Clarita and the surrounding Santa Clarita Valley communities.</p>
		</div>
	</section>

	<section class="content">
		<div class="container">
			<div class="content-grid">
				<div>
					<h2>Where We Work</h2>
					<p>We are a local company focused on residential and light commercial drain cleaning and sewer services throughout the Santa Clarita Valley. We understand the unique soil conditions, older plumbing systems, and tree-root challenges common in the area.</p>
					
					<h3>Primary Service Areas</h3>
					<ul>
						<li><strong>Santa Clarita, CA</strong> — Our home base. Full service for all neighborhoods.</li>
						<li>Valencia, CA</li>
						<li>Canyon Country, CA</li>
						<li>Newhall, CA</li>
						<li>Stevenson Ranch, CA</li>
						<li>Castaic, CA</li>
						<li>Saugus and nearby communities</li>
					</ul>
					
					<h3>Not Sure If We Cover Your Area?</h3>
					<p>If you live near Santa Clarita and need drain cleaning, hydro jetting, or a camera inspection, give us a call. We often serve additional nearby communities and will let you know quickly if we can help.</p>
				</div>
				<div>
					<h3>Our Location</h3>
					<p>{ADDRESS}</p>
					<div class="map-wrapper mt-2">
						<iframe
							src="https://maps.google.com/maps?q=25800+Turquesa+Dr,+Santa+Clarita,+CA+91355&t=&z=15&ie=UTF8&iwloc=&output=embed"
							title="Map showing 25800 Turquesa Dr, Santa Clarita, CA 91355"
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="cta">
		<div class="container">
			<h2>Serving Your Neighborhood</h2>
			<p>Call today to schedule service in Santa Clarita or nearby communities.</p>
			<a href={`tel:${PHONE_TEL}`} class="btn btn-primary">Call {PHONE}</a>
		</div>
	</section>

	<Footer />
</body>
</html>
